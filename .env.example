# BSCScan API key for deposit verification — https://bscscan.com/myapikey
# BSCSCAN_API_KEY=
# Minimum block confirmations before crediting deposits (default 12)
# DEPOSIT_MIN_CONFIRMATIONS=12

# On-chain Participation Program (legacy flag)
# PARTICIPATION_ON_CHAIN=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── PRODUCTION (HTTPS live site) — fixes "logged out on page refresh" ──
# The most common cause is a cookie domain / scheme mismatch. On the live
# server set APP_URL to the exact host users visit (with https), then:
#   1) Match SESSION_DOMAIN to that host so the cookie survives reloads.
#      Use a leading dot to share the cookie across www + root:
#      SESSION_DOMAIN=.racenetwork.live
#   2) Only send the session cookie over HTTPS:
#      SESSION_SECURE_COOKIE=true
#   3) Keep SameSite=lax (default) so normal navigation keeps the cookie:
#      SESSION_SAME_SITE=lax
#   4) Ensure the `sessions` table exists on the production DB:
#      php artisan migrate --force
#   5) After changing .env on the server, always clear the config cache:
#      php artisan config:clear && php artisan optimize
# IMPORTANT: pick ONE canonical host (all www OR all non-www) and redirect
# the other to it, otherwise the login cookie set on one host won't be sent
# back on the other and every refresh looks "logged out".

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Orchid admin panel — {APP_URL}/admin
PLATFORM_PREFIX=/admin
ADMIN_EMAIL=admin@admin.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me

# Create admin: php artisan orchid:admin "${ADMIN_NAME}" "${ADMIN_EMAIL}" "${ADMIN_PASSWORD}"
# Grant existing user: php artisan platform:grant-admin "${ADMIN_EMAIL}"
