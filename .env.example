APP_NAME="racenetwork.live"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production live (racenetwork.live — admin + ICO + member site):
# APP_URL=https://racenetwork.live
# ASSET_URL=https://racenetwork.live
# SESSION_DOMAIN=          # empty on racenetwork.live — a leading-dot domain breaks CSRF in TokenPocket
# SESSION_SECURE_COOKIE=true
# If needed, override admin CSS URL (must include /css/ in path):
# ADMIN_VIP_CSS_URL=https://racenetwork.live/css/admin-vip.css

# Orchid admin panel CSS/JS (run: php artisan rynex:publish-orchid-assets)
# ORCHID_ASSET_DIR=assets/orchid

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Fallback when admin has not saved Security settings yet:
# OTP_BYPASS=true  → password only | false → email OTP required
OTP_BYPASS=false
# Optional override (true/false). Admin panel: Security & OTP saves site_settings.otp_enabled
# OTP_ENABLED=true

# When true, the 6-digit OTP is also stored in otps.plain_code (for testing / phpMyAdmin). Use false in production.
OTP_STORE_PLAIN=true
OTP_MAILER=log
# OTP_FROM_ADDRESS="no-reply@example.com"
# OTP_FROM_NAME="${APP_NAME}"
# OTP_SMTP_HOST=smtp.example.com
# OTP_SMTP_PORT=587
# OTP_SMTP_USERNAME=your_smtp_user
# OTP_SMTP_PASSWORD=your_smtp_password
# OTP_SMTP_AUTH=true
# OTP_SMTP_ENCRYPTION=tls
# OTP_SMTP_TIMEOUT=1
# Income: pay sponsor levels 2–7 on top of MTH (default off)
INCOME_SPONSOR_EXTRA=false
# When true, principal is debited from users.balance_usd on new investment
INCOME_DEDUCT_INVESTMENT=false

# Treasury deposit address (BEP20 on BNB Smart Chain). Shown on Deposit page.
ADMIN_WALLET_BEP20=0xa6eD3cF59F3eaf6c4ee7DB1247212F7B13D6B595
