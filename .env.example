APP_NAME="racenetwork.live"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production: set to your real site URL (required for admin CSS/assets)
# APP_URL=https://yourdomain.com
# ASSET_URL=https://yourdomain.com
# If needed, override admin CSS URL (must include /css/ in path):
# ADMIN_VIP_CSS_URL=https://testing.arogyaspaa.com/css/admin-vip.css

# Orchid admin panel CSS/JS (run: php artisan rynex:publish-orchid-assets)
# ORCHID_ASSET_DIR=assets/orchid

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Fallback when admin has not saved Security settings yet:
# OTP_BYPASS=true  → password only | false → email OTP required
OTP_BYPASS=false
# Optional override (true/false). Admin panel: Security & OTP saves site_settings.otp_enabled
# OTP_ENABLED=true

# When true, the 6-digit OTP is also stored in otps.plain_code (for testing / phpMyAdmin). Use false in production.
OTP_STORE_PLAIN=true
OTP_MAILER=log
# OTP_FROM_ADDRESS="no-reply@example.com"
# OTP_FROM_NAME="${APP_NAME}"
# OTP_SMTP_HOST=smtp.example.com
# OTP_SMTP_PORT=587
# OTP_SMTP_USERNAME=your_smtp_user
# OTP_SMTP_PASSWORD=your_smtp_password
# OTP_SMTP_AUTH=true
# OTP_SMTP_ENCRYPTION=tls
# OTP_SMTP_TIMEOUT=1
# Income: pay sponsor levels 2–7 on top of MTH (default off)
INCOME_SPONSOR_EXTRA=false
# When true, principal is debited from users.balance_usd on new investment
INCOME_DEDUCT_INVESTMENT=false

# Treasury deposit address (BEP20 on BNB Smart Chain). Shown on Deposit page.
ADMIN_WALLET_BEP20=0xa6eD3cF59F3eaf6c4ee7DB1247212F7B13D6B595
# ADMIN_WALLET_NETWORK_LABEL="BEP20 (BNB Smart Chain)"

# =============================================================================
# BSC TESTNET wiring (authoritative addresses: contracts/deployments/bscTestnet/deployment.json)
# Never use Mainnet USDT/router while BSC_CHAIN_ID=97
# =============================================================================
# BSC_NETWORK=bsc_testnet
# BSC_CHAIN_ID=97
# BSC_RPC_URL=https://bsc-testnet.publicnode.com
# BSC_RPC_URL_FALLBACK_1=https://data-seed-prebsc-2-s1.binance.org:8545
# BSC_RPC_URL_FALLBACK_2=https://data-seed-prebsc-1-s2.binance.org:8545
# USDT_CONTRACT_BEP20=   # TestnetMockUSDT only on testnet
# PANCAKE_ROUTER=         # Pancake V2 testnet router
# RACE_TOKEN_CONTRACT=
# RACE_MULTISIG_CONTRACT=
# RACE_TREASURY_CONTRACT=
# RACE_DEVELOPMENT_TREASURY_CONTRACT=
# RACE_MARKETING_TREASURY_CONTRACT=
# RACE_OPERATIONS_TREASURY_CONTRACT=
# RACE_REWARD_VAULT_CONTRACT=
# RACE_REWARD_PRICE_ORACLE_CONTRACT=
# RACE_COMMUNITY_ENGINE_CONTRACT=
# RACE_PARTICIPATION_CONTRACT=
# Legacy RaceParticipation.sol — keep false; active path is RaceCommunityEngine
# RACE_LEGACY_PARTICIPATION_ENABLED=false
# RACE_ICO_CONTRACT=
# RACE_STAKING_CONTRACT=
# RACE_REWARD_POOL_CONTRACT=
# RACE_AUTO_LIQUIDITY_CONTRACT=
# RACE_LIQUIDITY_LOCKER_CONTRACT=
# RACE_GOVERNOR_CONTRACT=
# RACE_GOVERNANCE_CONTRACT=
# BLOCKCHAIN_INDEXER_ENABLED=true
# BLOCKCHAIN_INDEXER_START_BLOCK=
# BLOCKCHAIN_INDEXER_LOG_CHUNK=250
# BLOCKCHAIN_INDEXER_RPC_RETRIES=3
# REWARDS_ENGINE=blockchain_only
# PARTICIPATION_ON_CHAIN=true

# BSCScan API key for deposit verification — https://bscscan.com/myapikey
# BSCSCAN_API_KEY=
# Minimum block confirmations before crediting deposits (default 12)
# DEPOSIT_MIN_CONFIRMATIONS=12

# On-chain Participation Program (legacy flag)
# PARTICIPATION_ON_CHAIN=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── PRODUCTION (HTTPS live site) — fixes "logged out on page refresh" ──
# The most common cause is a cookie domain / scheme mismatch. On the live
# server set APP_URL to the exact host users visit (with https), then:
#   1) Match SESSION_DOMAIN to that host so the cookie survives reloads.
#      Use a leading dot to share the cookie across www + root:
#      SESSION_DOMAIN=.racenetwork.live
#   2) Only send the session cookie over HTTPS:
#      SESSION_SECURE_COOKIE=true
#   3) Keep SameSite=lax (default) so normal navigation keeps the cookie:
#      SESSION_SAME_SITE=lax
#   4) Ensure the `sessions` table exists on the production DB:
#      php artisan migrate --force
#   5) After changing .env on the server, always clear the config cache:
#      php artisan config:clear && php artisan optimize
# IMPORTANT: pick ONE canonical host (all www OR all non-www) and redirect
# the other to it, otherwise the login cookie set on one host won't be sent
# back on the other and every refresh looks "logged out".

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Orchid admin panel — {APP_URL}/admin
PLATFORM_PREFIX=/admin
ADMIN_EMAIL=admin@admin.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me

# Create admin: php artisan orchid:admin "${ADMIN_NAME}" "${ADMIN_EMAIL}" "${ADMIN_PASSWORD}"
# Grant existing user: php artisan platform:grant-admin "${ADMIN_EMAIL}"
