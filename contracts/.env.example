# =============================================================================
# BSC TESTNET ONLY — never put mainnet keys / RPC / USDT here for testnet work
# Copy to .env and fill REAL values. Do not commit .env
# =============================================================================

DEPLOY_ENV=testnet
CONFIRM_TESTNET_DEPLOYMENT=YES
EXPECTED_CHAIN_ID=97

# Deployer (testnet wallet private key — 64 hex, optional 0x prefix)
DEPLOYER_PRIVATE_KEY=

# Multisig 3-of-5 — addresses (canonical for deploy)
MULTISIG_SIGNER_1=
MULTISIG_SIGNER_2=
MULTISIG_SIGNER_3=
MULTISIG_SIGNER_4=
MULTISIG_SIGNER_5=
# MULTISIG_SIGNERS=0xA,0xB,0xC,0xD,0xE
MULTISIG_THRESHOLD=3

# Optional: private keys used ONLY to derive the addresses above (never commit / never log)
# After saving keys, run: npm run sync:testnet-multisig-signers
# MULTISIG_PRIVATE_KEY_1=
# MULTISIG_PRIVATE_KEY_2=
# MULTISIG_PRIVATE_KEY_3=
# MULTISIG_PRIVATE_KEY_4=
# MULTISIG_PRIVATE_KEY_5=
# Also accepted: MULTISIG_SIGNER_PRIVATE_KEY_1..5 | MULTISIG_PK_1..5 | MULTISIG_PRIVATE_KEYS=k1,k2,k3,k4,k5

# Community Governance (10–12) — either indexed OR csv
GOVERNANCE_MEMBER_1=
GOVERNANCE_MEMBER_2=
GOVERNANCE_MEMBER_3=
GOVERNANCE_MEMBER_4=
GOVERNANCE_MEMBER_5=
GOVERNANCE_MEMBER_6=
GOVERNANCE_MEMBER_7=
GOVERNANCE_MEMBER_8=
GOVERNANCE_MEMBER_9=
GOVERNANCE_MEMBER_10=
GOVERNANCE_MEMBER_11=
GOVERNANCE_MEMBER_12=
# GOVERNANCE_MEMBERS=0x1,0x2,...,0xc
GOVERNANCE_THRESHOLD=7
GOVERNANCE_VOTING_PERIOD_SECONDS=259200
GOVERNANCE_TIMELOCK_SECONDS=86400

# Testnet RPC (aliases: BSC_TESTNET_RPC_URL)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
# Optional fallbacks if primary times out (Testnet only — never mainnet)
BSC_TESTNET_RPC_FALLBACK_1=https://data-seed-prebsc-2-s1.binance.org:8545
BSC_TESTNET_RPC_FALLBACK_2=https://data-seed-prebsc-1-s2.binance.org:8545
# BSC_TESTNET_RPC_TIMEOUT_MS=12000
# BSC_TESTNET_RPC_URL=

# Testnet USDT + Pancake — REQUIRED on chain 97 (mainnet defaults are refused)
# Aliases accepted: TESTNET_USDT_ADDRESS, PANCAKE_ROUTER_ADDRESS
TESTNET_USDT_ADDRESS=
PANCAKE_ROUTER_ADDRESS=0xD99D1c33F9fC3444f8101754aBC46c52416550D1
# USDT=
# PANCAKE_ROUTER=

# Transfer Engine/Oracle/Treasury/RaceCoin/ICO/Vault → MultiSig after deploy
HARDEN_GOVERNANCE=1

# Reward oracle (USDT per 1 RACE). Set an explicit TESTNET price, e.g. 0.05
RACE_REWARD_PRICE_USDT=0.05
RACE_REWARD_PRICE_MIN=0.01
RACE_REWARD_PRICE_MAX=100

# Optional roles
# ORACLE_UPDATER=0x...
# ICO_ADMIN_WALLET=0x...

# Do NOT enable mainnet in this file while testing:
# BSC_MAINNET_RPC=
